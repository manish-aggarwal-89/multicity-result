  --header 'serviceId: GATEWAY' \
  --header 'requestId: ed67f36e-a6ab-497e-aaf4-441a0e6ef877' \
  --header 'Content-Type: application/json' \
  --header 'Accept: application/json' \
  --data '{"distributionType": "sabre", "bookingCode": "KKCNLD", "account": {"code": "tiketcomSabre", "name": "tiketcomSabre"}}'
